{
  "name": "chatgpt-ctrl-enter-sender-firefox",
  "version": "2.5.8.1",
  "private": true,
  "description": "Firefox extension that assigns Ctrl+Enter to send messages in ChatGPT and other AI chat sites",
  "main": "service-worker.js",
  "scripts": {
    "bump": "node tools/bump-version.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tools/*.test.js",
    "test:integration": "wdio run wdio.conf.js",
    "test:loading": "wdio run wdio.conf.js --spec tests/extension-loading.spec.js",
    "test:live": "wdio run wdio.live.conf.js",
    "test:sites": "wdio run wdio.live.conf.js --spec tests/live/site-accessibility.spec.js",
    "test:behavior": "wdio run wdio.live.conf.js --spec tests/live/ctrl-enter-behavior.spec.js",
    "test:public": "wdio run wdio.live.conf.js --mochaOpts.grep=\"Public Sites\"",
    "login": "node tests/login-helper.js",
    "login:all": "node tests/login-helper.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xolli/ChatGPT-Ctrl-Enter-Sender-Firefox.git"
  },
  "keywords": [],
  "author": "Kamada Masachika, Xolli",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/xolli/ChatGPT-Ctrl-Enter-Sender-Firefox/issues"
  },
  "homepage": "https://github.com/xolli/ChatGPT-Ctrl-Enter-Sender-Firefox#readme",
  "devDependencies": {
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "adm-zip": "^0.6.1",
    "expect-webdriverio": "^6.1.0",
    "geckodriver": "^5.0.0",
    "webdriverio": "^9.32.0"
  }
}
